---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.tsx";
import Footer from "../../components/Footer.tsx";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const backgrounds = await getCollection("backgrounds");
  return backgrounds.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Missing slug for background page.");
}

const entry = await getEntry("backgrounds", slug);

if (!entry) {
  throw new Error(`Background entry not found for slug: ${slug}`);
}

const { Content } = await render(entry);

const withBase = (p?: string) => {
  if (!p) return undefined;
  const base = import.meta.env.BASE_URL || "/";
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const pp = p.startsWith("/") ? p.slice(1) : p;
  return `${b}/${pp}`;
};

const image = withBase(entry.data.image);
const title = entry.data.title;
const summary = entry.data.summary;
---

<Base title={`${title} – CPO`}>
  <Fragment slot="header"><Nav client:load /></Fragment>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <a
      href={withBase("cpo/")}
      class="inline-flex items-center text-sm opacity-70 transition hover:opacity-100"
    >
      ← Tillbaka
    </a>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-stretch">
      <div class="rounded-2xl border p-6 sm:p-8 min-h-[420px] flex flex-col justify-center">
        <p class="text-sm uppercase tracking-[0.18em] opacity-60">CPO / Bakgrund</p>

        <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">{title}</h1>

        {summary && (
          <p class="mt-4 max-w-2xl text-base leading-relaxed opacity-80 sm:text-lg">
            {summary}
          </p>
        )}
      </div>

      {image && (
        <div class="rounded-2xl border p-6 sm:p-8 min-h-[420px] flex items-center justify-center">
          <img
            src={image}
            alt={title}
            class="max-h-[320px] w-auto max-w-full object-contain sm:max-h-[380px]"
            loading="eager"
            decoding="async"
          />
        </div>
      )}
    </div>

    <div class="mt-10 rounded-2xl border p-6 sm:p-8">
      <article
        class="prose prose-slate dark:prose-invert max-w-none
         prose-headings:scroll-mt-24
         prose-h2:mt-10
         prose-h2:mb-3
         prose-h2:text-2xl
         prose-h2:font-bold
         prose-h2:tracking-tight
         prose-h2:border-b
         prose-h2:pb-2
         prose-p:leading-7
         prose-p:opacity-90
         prose-strong:text-inherit"
      >
        <Content />
      </article>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</Base>
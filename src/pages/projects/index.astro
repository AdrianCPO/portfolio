---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.tsx";
import Footer from "../../components/Footer.tsx";
import ProjectsGrid, { type Project } from "../../components/ProjectsGrid.tsx"; 
import ReposGrid from "../../components/ReposGrid.tsx";
import { getCollection, type CollectionEntry } from "astro:content";
import { getUserRepos } from "../../lib/github";
import { effect } from "astro:schema";

// Säker join av BASE_URL + path
const withBase = (p?: string) => {
  if (!p) return undefined;
  const base = import.meta.env.BASE_URL || "/";
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const pp = p.startsWith("/") ? p.slice(1) : p;
  return `${b}/${pp}`;
};

// ---- Hämta projekt ----
type ProjEntry = CollectionEntry<"projects">;

const raw = await getCollection("projects");
const projects: Project[] = raw
  .map((p: ProjEntry): Project => ({
    slug: p.data.slug ?? p.slug,
    title: p.data.title,
    summary: p.data.summary,
    tags: p.data.tags,
    image: withBase(p.data.image),
    poster: withBase(p.data.poster ?? p.data.image),
    previewVideo: withBase(p.data.previewVideo),
    repo: p.data.repo,
    demo: p.data.demo,
    date: p.data.date ?? null,
  }))
  .sort((a: Project, b: Project) => (b.date ?? "").localeCompare(a.date ?? ""));

type Skill = {
  key: string;
  label: string;
  icon: string;
  count?: number;
  href?: string;
};

const skillMeta: Record<string, Skill> = {
  react: { key: "react", label: "React", icon: "⚛️", href: "https://react.dev" },
  astro: { key: "astro", label: "Astro", icon: "🌟", href: "https://astro.build" },
  tailwind: { key: "tailwind", label: "Tailwind", icon: "💨", href: "https://tailwindcss.com" },
  typescript: { key: "typescript", label: "TypeScript", icon: "🟦", href: "https://www.typescriptlang.org" },
  javascript: { key: "javascript", label: "JavaScript", icon: "🟨" },
  gsap: { key: "gsap", label: "GSAP", icon: "🌀", href: "https://gsap.com" },
  lottie: { key: "lottie", label: "Lottie", icon: "🎞️", href: "https://airbnb.io/lottie/#/" },
  harvest: { key: "harvest", label: "Harvest", icon: "⏱️", href: "https://www.getharvest.com/" },
  wordpress: { key: "wordpress", label: "WordPress", icon: "🪄", href: "https://wordpress.org" },
  php: { key: "php", label: "PHP", icon: "🐘", href: "https://www.php.net" },
  html: { key: "html", label: "HTML", icon: "📄", href: "https://developer.mozilla.org/en-US/docs/Web/HTML" },
  css: { key: "css", label: "CSS", icon: "🎨", href: "https://developer.mozilla.org/en-US/docs/Web/CSS" },
  figma: { key: "figma", label: "Figma", icon: "🎛️", href: "https://figma.com" },
  git: { key: "git", label: "Git", icon: "🔧", href: "https://git-scm.com" },
  github: { key: "github", label: "GitHub", icon: "🐙", href: "https://github.com" },
  vite: { key: "vite", label: "Vite", icon: "⚡", href: "https://vitejs.dev" },
  node: { key: "node", label: "Node.js", icon: "🟢", href: "https://nodejs.org" },
  nextjs: { key: "nextjs", label: "Next.js", icon: "▲", href: "https://nextjs.org" },
  jira: { key: "jira", label: "Jira", icon: "📘", href: "https://www.atlassian.com/software/jira" },
  "after effects": {
    key: "after effects",
    label: "After Effects",
    icon: "🎬",
    href: "https://www.adobe.com/aftereffects",
  },
  "trello board": {
    key: "trello board",
    label: "Trello Board",
    icon: "📋",
    href: "https://trello.com",
  },
  mysql: { key: "mysql", label: "MySQL", icon: "🐬", href: "https://www.mysql.com" },
  drupal: { key: "drupal", label: "Drupal", icon: "🌊", href: "https://www.drupal.org" },
  twig: { key: "twig", label: "Twig", icon: "🍃", href: "https://twig.symfony.com" },
};

const normalizeSkillKey = (value: string) => value.trim().toLowerCase();

const fallbackLabel = (key: string) =>
  key
    .split(/[\s-]+/)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");

const tagCounts = new Map<string, number>();

for (const p of projects) {
  for (const tag of p.tags ?? []) {
    const key = normalizeSkillKey(String(tag));
    tagCounts.set(key, (tagCounts.get(key) ?? 0) + 1);
  }
}

const derivedSkills: Skill[] = Array.from(tagCounts.entries()).map(([key, count]) => {
  const meta = skillMeta[key] ?? {
    key,
    label: fallbackLabel(key),
    icon: "🔧",
  };

  return {
    ...meta,
    count,
  };
});

const extras = [
  "react",
  "astro",
  "tailwind",
  "typescript",
  "javascript",
  "gsap",
  "lottie",
  "harvest",
  "wordpress",
  "php",
  "figma",
  "git",
  "github",
  "vite",
  "node",
  "nextjs",
  "jira",
  "after effects",
  "trello board",
  "mysql",
  "html",
  "css",
  "drupal",
  "twig",
];

const seen = new Set(derivedSkills.map((skill) => skill.key));

for (const extra of extras) {
  const key = normalizeSkillKey(extra);
  const meta = skillMeta[key];

  if (meta && !seen.has(key)) {
    derivedSkills.push(meta);
    seen.add(key);
  }
}

const skills: Skill[] = derivedSkills
  .sort((a, b) => {
    const countDiff = (b.count ?? 0) - (a.count ?? 0);
    if (countDiff !== 0) return countDiff;
    return a.label.localeCompare(b.label, "sv");
  })
  .slice(0, 30);

// ---- GitHub-repon (server/build) + filtrera bort dubbletter som redan har case ----
function extractRepoName(url?: string | null) {
  if (!url) return null;
  const m = url.match(/github\.com\/[\w-]+\/([\w.-]+)/i);
  return m?.[1]?.toLowerCase() ?? null;
}
const existingNames = new Set(
  projects.map((p) => extractRepoName(p.repo)).filter(Boolean) as string[]
);

const username = "AdrianCPO";
const token = import.meta.env.GITHUB_TOKEN as string | undefined; // valfritt
const ghAll = await getUserRepos({ username, token, hideForks: true, includeArchived: false });

const ghRepos = ghAll
  .filter((r) => !existingNames.has(r.name.toLowerCase()))
  .map((r) => ({
    name: r.name,
    html_url: r.html_url,
    description: r.description,
    language: r.language,
    stargazers_count: r.stargazers_count,
    forks_count: r.forks_count,
    homepage: r.homepage,
    pushed_at: r.pushed_at,
  }));
---

<Base title="Projekt – Adrian">
  <Fragment slot="header"><Nav client:load /></Fragment>

  <h1 class="text-2xl font-bold mb-4">Projekt</h1>

  <!-- Kompetenser (chips) -->
  <section class="mb-6 rounded-xl border p-4">
  <h2 class="text-base font-semibold mb-2">Kompetenser</h2>

  <ul class="flex flex-wrap gap-2">
    {skills.map((s) => (
      <li>
        <a
          href={s.href ?? "#projects-list"}
          target={s.href ? "_blank" : undefined}
          rel={s.href ? "noreferrer" : undefined}
          class="inline-flex items-center gap-1 rounded-full border px-3 py-1 text-xs hover:bg-slate-50 dark:hover:bg-slate-800"
          aria-label={`Kompetens: ${s.label}${s.count ? `, används i ${s.count} projekt` : ""}`}
        >
          <span aria-hidden="true">{s.icon}</span>
          <span>{s.label}</span>
          {s.count ? <span class="opacity-70">({s.count})</span> : null}
        </a>
      </li>
    ))}
  </ul>
</section>

  <!-- Dina kuraterade case -->
  <div id="projects-list">
    <ProjectsGrid client:load items={projects} />
  </div>

  <!-- Övriga GitHub-repon under, utan dubbletter -->
  {ghRepos.length ? (
    <section class="mt-10">
      <h2 class="text-xl font-semibold mb-3">Övriga GitHub-repon</h2>
      <ReposGrid items={ghRepos} />
    </section>
  ) : null}

  <Fragment slot="footer"><Footer /></Fragment>
</Base>
